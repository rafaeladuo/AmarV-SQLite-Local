<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="maui_amarv.Views.BackupPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">

    <Grid>

        <Image Source="amarv_logo.png"
               Opacity="0.06"
               Aspect="AspectFit"
               HorizontalOptions="Center"
               VerticalOptions="Center" />

        <VerticalStackLayout Padding="20"
                             Spacing="15"
                             VerticalOptions="Center">

            <Label Text="Backup"
                   FontSize="30"
                   FontAttributes="Bold"
                   TextColor="{StaticResource Primary}"
                   HorizontalTextAlignment="Center" />

            <Frame Padding="15"
                   BackgroundColor="White"
                   BorderColor="#DDDDDD">

                <VerticalStackLayout Spacing="12">

                    <Label x:Name="lbl_usuario"
                           TextColor="Black"
                           FontSize="14"
                           HorizontalTextAlignment="Center" />

                    <Label x:Name="lbl_status"
                           Text="Status: nenhum backup realizado nesta sessão."
                           FontSize="16"
                           TextColor="Black" />

                    <Label Text="O backup é uma função administrativa para gerar cópia local do banco de dados."
                           TextColor="Black"
                           FontSize="14" />

                    <Button Text="Realizar Backup"
                            Clicked="Button_Backup_Clicked" />

                    <Button Text="Voltar ao Menu"
                            Clicked="Button_Menu_Clicked" />

                </VerticalStackLayout>

            </Frame>

        </VerticalStackLayout>

    </Grid>

</ContentPage>