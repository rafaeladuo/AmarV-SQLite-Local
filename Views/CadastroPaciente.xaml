<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="maui_amarv.Views.CadastroPaciente"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">

    <Grid>

        <Image Source="amarv_logo.png"
               Opacity="0.06"
               Aspect="AspectFit"
               HorizontalOptions="Center"
               VerticalOptions="Center" />

        <ScrollView>
            <VerticalStackLayout Padding="20"
                                 Spacing="15">

                <Label Text="Cadastro de Paciente"
                       FontSize="30"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Primary}"
                       HorizontalTextAlignment="Center" />

                <Frame Padding="15"
                       BackgroundColor="White"
                       BorderColor="#DDDDDD">

                    <VerticalStackLayout Spacing="12">

                        <Label Text="Nome do paciente:" TextColor="Black" />
                        <Entry x:Name="entry_nome"
                               Placeholder="Digite o nome do paciente"
                               TextColor="Black"
                               PlaceholderColor="Gray"
                               BackgroundColor="White" />

                        <Label Text="Nome da mãe:" TextColor="Black" />
                        <Entry x:Name="entry_nome_mae"
                               Placeholder="Digite o nome da mãe"
                               TextColor="Black"
                               PlaceholderColor="Gray"
                               BackgroundColor="White" />

                        <Label Text="CPF:" TextColor="Black" />
                        <Entry x:Name="entry_cpf"
                               Placeholder="Digite o CPF"
                               Keyboard="Numeric"
                               TextColor="Black"
                               PlaceholderColor="Gray"
                               BackgroundColor="White" />

                        <Label Text="Telefone:" TextColor="Black" />
                        <Entry x:Name="entry_telefone"
                               Placeholder="Digite o telefone"
                               Keyboard="Telephone"
                               TextColor="Black"
                               PlaceholderColor="Gray"
                               BackgroundColor="White" />

                        <Label Text="Rua:" TextColor="Black" />
                        <Entry x:Name="entry_rua"
                               Placeholder="Digite a rua"
                               TextColor="Black"
                               PlaceholderColor="Gray"
                               BackgroundColor="White" />

                        <Label Text="Endereço completo:" TextColor="Black" />
                        <Entry x:Name="entry_endereco"
                               Placeholder="Digite o endereço completo"
                               TextColor="Black"
                               PlaceholderColor="Gray"
                               BackgroundColor="White" />

                        <Label Text="Cartão SUS:" TextColor="Black" />
                        <Entry x:Name="entry_cartao_sus"
                               Placeholder="Digite o Cartão SUS"
                               Keyboard="Numeric"
                               TextColor="Black"
                               PlaceholderColor="Gray"
                               BackgroundColor="White" />

                        <Label Text="Sexo:" TextColor="Black" />
                        <Picker x:Name="pck_sexo"
                                Title="Selecione o sexo"
                                TextColor="Black"
                                TitleColor="Gray"
                                BackgroundColor="White">
                            <Picker.Items>
                                <x:String>Masculino</x:String>
                                <x:String>Feminino</x:String>
                                <x:String>Outro</x:String>
                            </Picker.Items>
                        </Picker>

                        <Label Text="Idade em anos:" TextColor="Black" />
                        <Entry x:Name="entry_idade_anos"
                               Placeholder="Ex: 8"
                               Keyboard="Numeric"
                               TextColor="Black"
                               PlaceholderColor="Gray"
                               BackgroundColor="White" />

                        <Label Text="Meses adicionais:" TextColor="Black" />
                        <Entry x:Name="entry_idade_meses"
                               Placeholder="Ex: 0"
                               Keyboard="Numeric"
                               TextColor="Black"
                               PlaceholderColor="Gray"
                               BackgroundColor="White" />

                        <Label Text="Condições clínicas:"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}" />

                        <VerticalStackLayout Spacing="8">

                            <HorizontalStackLayout x:Name="linha_nenhuma" Spacing="8" HeightRequest="48">
                                <CheckBox x:Name="chk_nenhuma"
                                          Color="#1B5E20"
                                          Scale="1.4"
                                          CheckedChanged="Condicao_CheckedChanged" />
                                <Label Text="Nenhuma" VerticalOptions="Center" TextColor="Black" />
                            </HorizontalStackLayout>

                            <HorizontalStackLayout x:Name="linha_gestante" Spacing="8" HeightRequest="48">
                                <CheckBox x:Name="chk_gestante"
                                          Color="#1B5E20"
                                          Scale="1.4"
                                          CheckedChanged="Condicao_CheckedChanged" />
                                <Label Text="Gestante" VerticalOptions="Center" TextColor="Black" />
                            </HorizontalStackLayout>

                            <Label Text="Semanas de gestação:" TextColor="Black" />
                            <Entry x:Name="entry_semanas_gestacao"
                                   Placeholder="Ex: 20"
                                   Keyboard="Numeric"
                                   TextColor="Black"
                                   PlaceholderColor="Gray"
                                   BackgroundColor="White" />

                            <HorizontalStackLayout x:Name="linha_lactante" Spacing="8" HeightRequest="48">
                                <CheckBox x:Name="chk_lactante"
                                          Color="#1B5E20"
                                          Scale="1.4"
                                          CheckedChanged="Condicao_CheckedChanged" />
                                <Label Text="Lactante / Amamentando" VerticalOptions="Center" TextColor="Black" />
                            </HorizontalStackLayout>

                            <HorizontalStackLayout x:Name="linha_lactante_bebe" Spacing="8" HeightRequest="48">
                                <CheckBox x:Name="chk_lactante_bebe"
                                          Color="#1B5E20"
                                          Scale="1.4"
                                          CheckedChanged="Condicao_CheckedChanged" />
                                <Label Text="Lactante com bebê menor de 6 meses" VerticalOptions="Center" TextColor="Black" />
                            </HorizontalStackLayout>

                            <HorizontalStackLayout x:Name="linha_imunossuprimido" Spacing="8" HeightRequest="48">
                                <CheckBox x:Name="chk_imunossuprimido"
                                          Color="#1B5E20"
                                          Scale="1.4"
                                          CheckedChanged="Condicao_CheckedChanged" />
                                <Label Text="Imunossuprimido / Imunodeficiência" VerticalOptions="Center" TextColor="Black" />
                            </HorizontalStackLayout>

                            <HorizontalStackLayout x:Name="linha_hiv" Spacing="8" HeightRequest="48">
                                <CheckBox x:Name="chk_hiv"
                                          Color="#1B5E20"
                                          Scale="1.4"
                                          CheckedChanged="Condicao_CheckedChanged" />
                                <Label Text="HIV" VerticalOptions="Center" TextColor="Black" />
                            </HorizontalStackLayout>

                            <HorizontalStackLayout x:Name="linha_quimioterapia" Spacing="8" HeightRequest="48">
                                <CheckBox x:Name="chk_quimioterapia"
                                          Color="#1B5E20"
                                          Scale="1.4"
                                          CheckedChanged="Condicao_CheckedChanged" />
                                <Label Text="Quimioterapia" VerticalOptions="Center" TextColor="Black" />
                            </HorizontalStackLayout>

                            <HorizontalStackLayout x:Name="linha_transplante" Spacing="8" HeightRequest="48">
                                <CheckBox x:Name="chk_transplante"
                                          Color="#1B5E20"
                                          Scale="1.4"
                                          CheckedChanged="Condicao_CheckedChanged" />
                                <Label Text="Transplantado" VerticalOptions="Center" TextColor="Black" />
                            </HorizontalStackLayout>

                            <HorizontalStackLayout x:Name="linha_corticoide" Spacing="8" HeightRequest="48">
                                <CheckBox x:Name="chk_corticoide"
                                          Color="#1B5E20"
                                          Scale="1.4"
                                          CheckedChanged="Condicao_CheckedChanged" />
                                <Label Text="Uso de corticoide ou imunobiológico" VerticalOptions="Center" TextColor="Black" />
                            </HorizontalStackLayout>

                            <HorizontalStackLayout x:Name="linha_alergia" Spacing="8" HeightRequest="48">
                                <CheckBox x:Name="chk_alergia"
                                          Color="#1B5E20"
                                          Scale="1.4"
                                          CheckedChanged="Condicao_CheckedChanged" />
                                <Label Text="Alergia grave / Anafilaxia" VerticalOptions="Center" TextColor="Black" />
                            </HorizontalStackLayout>

                            <HorizontalStackLayout x:Name="linha_febre" Spacing="8" HeightRequest="48">
                                <CheckBox x:Name="chk_febre"
                                          Color="#1B5E20"
                                          Scale="1.4"
                                          CheckedChanged="Condicao_CheckedChanged" />
                                <Label Text="Febre, infecção ou doença aguda" VerticalOptions="Center" TextColor="Black" />
                            </HorizontalStackLayout>

                        </VerticalStackLayout>

                        <Button Text="Salvar Paciente"
                                Clicked="Button_Clicked"
                                Margin="0,15,0,0" />

                        <Button Text="Consultar Pacientes"
                                Clicked="Button_Consultar_Clicked" />

                        <Button Text="Voltar ao Menu"
                                Clicked="Button_Menu_Clicked"
                                HorizontalOptions="Center" />

                    </VerticalStackLayout>

                </Frame>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>