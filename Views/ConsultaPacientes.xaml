<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="maui_amarv.Views.ConsultaPacientes"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">

    <Grid Padding="20"
          RowDefinitions="Auto, *, Auto, Auto"
          RowSpacing="15">

        <Label Grid.Row="0"
               Text="Pacientes Cadastrados"
               FontSize="30"
               FontAttributes="Bold"
               TextColor="{StaticResource Primary}"
               HorizontalTextAlignment="Center" />

        <CollectionView Grid.Row="1"
                        x:Name="collection_pacientes">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,5"
                           Padding="12"
                           BackgroundColor="White"
                           BorderColor="#CCCCCC">

                        <VerticalStackLayout Spacing="8">

                            <Label Text="{Binding Nome}"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" />

                            <Label Text="{Binding IdadeFormatada, StringFormat='Idade: {0}'}"
                                   TextColor="Black" />

                            <Label Text="{Binding CondicaoClinica, StringFormat='Condição clínica: {0}'}"
                                   TextColor="Black" />

                            <Label Text="{Binding SituacaoEspecial, StringFormat='Situação especial: {0}'}"
                                   TextColor="Black" />

                            <HorizontalStackLayout Spacing="10">

                                <Button Text="Editar"
                                        Clicked="Button_Editar_Clicked"
                                        BackgroundColor="#2B7A78"
                                        TextColor="White" />

                                <Button Text="Deletar"
                                        Clicked="Button_Deletar_Clicked"
                                        BackgroundColor="#B00020"
                                        TextColor="White" />

                            </HorizontalStackLayout>

                        </VerticalStackLayout>

                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

        <Button Grid.Row="2"
                Text="Voltar"
                Clicked="Button_Voltar_Clicked"
                HorizontalOptions="Center" />

        <Button Grid.Row="3"
                Text="Voltar ao Menu"
                Clicked="Button_Menu_Clicked"
                HorizontalOptions="Center" />

    </Grid>

</ContentPage>